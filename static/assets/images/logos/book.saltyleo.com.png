<style>
  :root{
  --card-radius: 16px;
}
/* 仅允许横向手势，避免 iOS Safari 在横滑时触发纵向滚动 */
.carousel-viewport{
  touch-action: pan-x;
  -ms-touch-action: pan-x; /* 兼容旧 Edge */
}
.author-carousel{ position: relative; margin: 14px 0; }
.carousel-viewport{ position: relative; overflow: hidden; width: 100%; border-radius: 18px; padding: 6px 0; }
.carousel-track{ display: flex; flex-wrap: nowrap; will-change: transform; transition: transform .45s ease; }

.author-grid-col{ flex: 0 0 auto; padding: 0 6px; }
@media (max-width: 480px){ .author-grid-col{ flex-basis:50%; max-width:50%; } }
@media (min-width:481px) and (max-width:640px){ .author-grid-col{ flex-basis:33.3333%; max-width:33.3333%; } }
@media (min-width:641px) and (max-width:1024px){ .author-grid-col{ flex-basis:25%; max-width:25%; } }
@media (min-width:1025px){ .author-grid-col{ flex-basis:20%; max-width:20%; } }

.author-card{
  position: relative;
  display:block;
  width:100%;
  height:100px;                 
  border-radius: var(--card-radius);
  overflow:hidden;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  text-decoration:none;
  transition: transform .25s ease;
}
.author-card:hover{ transform: translateY(-2px) scale(1.02); }

.author-card.more-card{
  background: linear-gradient(180deg, rgba(0,0,0,.6), rgba(0,0,0,.35));
  display:flex; align-items:center; justify-content:center;
}
.author-card.more-card span{
  color:#fff; font-weight:700; letter-spacing:.04em; font-size:25px;
}

.edge-overlay{
  position:absolute; top:50%; transform:translateY(-50%);
  width: 40px !important;
  height: 100px !important;
  border:0; padding:0; cursor:pointer;
  border-radius:50%;
  background: rgba(255, 255, 255, 0);
  display:flex; align-items:center; justify-content:center;
  z-index:5;
  -webkit-tap-highlight-color: transparent;
}
.edge-overlay.left{ left: 7px; }
.edge-overlay.right{ right:7px; }
.edge-overlay:hover{ background: rgba(255, 255, 255, 0); }
.edge-overlay svg{ width:24px; height:24px; color:#fff; pointer-events:none; opacity:.95; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.8)); }

</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  function getVisibleCount() {
    if (window.matchMedia('(max-width: 480px)').matches) return 2;
    if (window.matchMedia('(min-width: 481px) and (max-width: 640px)').matches) return 3;
    if (window.matchMedia('(min-width: 641px) and (max-width: 1024px)').matches) return 4;
    return 5;
  }

  function setupCarousel(root) {
    const viewport = root.querySelector('.carousel-viewport');
    const track    = root.querySelector('.carousel-track');
    const prevBtn  = root.querySelector('.js-prev');
    const nextBtn  = root.querySelector('.js-next');

    // 明确：不支持拖动/滑动
    if (viewport) {
      viewport.style.touchAction = 'none';
      viewport.onpointerdown = null;
      viewport.ontouchstart = null;
      viewport.onmousedown = null;
    }

    const originals = Array.from(track.children);
    const TOTAL = originals.length;

    let visible = getVisibleCount();
    let itemPercent = 100 / visible;
    let current = 0;
    let isMoving = false;

    const CLICK_STEP = 2; // 每次点击移动的卡片数

    function build() {
      const wasIndex = current; // 记录当前位置（可按需复用）
      visible = getVisibleCount();
      itemPercent = 100 / visible;

      track.innerHTML = '';
      const head = originals.map(n => n.cloneNode(true));
      const tail = originals.map(n => n.cloneNode(true));
      const nodes = [...head, ...originals, ...tail];
      nodes.forEach(n => track.appendChild(n));

      Array.from(track.children).forEach(col => {
        col.style.flexBasis = itemPercent + '%';
        col.style.maxWidth  = itemPercent + '%';
      });

      current = TOTAL; // 居中到原始列表的起始
      setTranslate(-current * itemPercent, false);
    }

    function setTranslate(percent, withTransition = true) {
      track.style.transition = withTransition ? 'transform .45s ease' : 'none';
      track.style.transform = `translateX(${percent}%)`;
      if (!withTransition) {
        // 立刻生效后恢复过渡
        void track.offsetHeight;
        track.style.transition = 'transform .45s ease';
      }
    }

    function step(dir, magnitude = 1) {
      if (isMoving) return;
      isMoving = true;
      current += dir * magnitude;
      setTranslate(-current * itemPercent, true);
    }

    track.addEventListener('transitionend', () => {
      // 无缝循环
      if (current < TOTAL) {
        current += TOTAL;
        setTranslate(-current * itemPercent, false);
      } else if (current >= TOTAL + TOTAL) {
        current -= TOTAL;
        setTranslate(-current * itemPercent, false);
      }
      isMoving = false;
    });

    // 仅保留按钮点击
    prevBtn.addEventListener('click', () => step(-1, CLICK_STEP));
    nextBtn.addEventListener('click', () => step(+1, CLICK_STEP));

    // 可选：键盘无障碍（左右方向键控制）
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { step(-1, CLICK_STEP); }
      else if (e.key === 'ArrowRight') { step(+1, CLICK_STEP); }
    });

    // 页面尺寸变化时重建
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(build, 120);
    });

    build();
  }

  document.querySelectorAll('.seauthor-carousel').forEach(setupCarousel);
});
</script>



