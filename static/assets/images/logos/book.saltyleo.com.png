  background-size: 300% 300%;
  border: none;
  border-radius: 25px;
  text-decoration: none;
  animation: gradientFlow 4s ease infinite;
  box-shadow: 0 2px 8px rgba(226, 157, 93, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.category-hint-btn:hover {
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(226, 157, 93, 0.5);
}

@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

[data-theme="dark"] .category-hint-btn {
  background: linear-gradient(135deg, #6b8cce, #5a7bc0, #4a6cb3, #5a7bc0, #6b8cce);
  background-size: 300% 300%;
  box-shadow: 0 2px 8px rgba(107, 140, 206, 0.3);
}

[data-theme="dark"] .category-hint-btn:hover {
  box-shadow: 0 4px 12px rgba(107, 140, 206, 0.5);
}</style>


