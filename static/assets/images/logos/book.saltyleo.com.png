<script>
(function() {
  'use strict';
  
  const detectionResults = {
    startTime: Date.now(),
    totalTests: 7,
    completedTests: 0,
    results: [],
    hasAdBlock: false,
    blockedMethods: [],
    isRecheck: false
  };
  
  function resetDetectionResults() {
    detectionResults.startTime = Date.now();
    detectionResults.completedTests = 0;
    detectionResults.results = [];
    detectionResults.hasAdBlock = false;
    detectionResults.blockedMethods = [];
    detectionResults.isRecheck = true;
  }
  
  function recordResult(methodName, status, details, category) {
    const result = {
      method: methodName,
      status: status,
      timestamp: Date.now(),
      duration: Date.now() - detectionResults.startTime,
      details: details || {},
      adBlockDetected: status === 'blocked',
      category: category || 'local'
    };
    
    detectionResults.results.push(result);
    detectionResults.completedTests++;
    
    if (result.adBlockDetected) {
      detectionResults.blockedMethods.push(methodName);
    }
    
    if (detectionResults.completedTests === detectionResults.totalTests) {
      setTimeout(showDetectionSummary, 100);
    }
  }
  
  function detectByBaitElement() {
    const baits = [
      createBait('ad ads adsbox ad-placement banner-ad', 'bait1'),
      createBait('adsbygoogle ad-slot google-ad', 'bait2'),
      createBait('advertisement pub_300x250 pub_728x90', 'bait3'),
      createBait('ad-container sponsored-content ad-wrapper', 'bait4'),
      createBait('ad-text ad_iframe ad-label native-ad', 'bait5')
    ];
    
    function createBait(className, id) {
      const bait = document.createElement('div');
      bait.className = className;
      bait.id = id;
      bait.style.cssText = 'position:absolute;top:-1px;left:-1px;width:1px;height:1px;';
      document.body.appendChild(bait);
      return bait;
    }
    
    setTimeout(function() {
      let blockedCount = 0;
      let baitDetails = [];
      
      baits.forEach(function(bait) {
        const isHidden = bait.offsetHeight === 0 || 
                        bait.offsetWidth === 0 || 
                        window.getComputedStyle(bait).display === 'none' ||
                        window.getComputedStyle(bait).visibility === 'hidden';
        
        baitDetails.push({
          id: bait.id,
          className: bait.className,
          被屏蔽: isHidden,
          高度: bait.offsetHeight,
          宽度: bait.offsetWidth,
          display: window.getComputedStyle(bait).display
        });
        
        if (isHidden) {
          blockedCount++;
        }
        
        document.body.removeChild(bait);
      });
      
      if (blockedCount > 0) {
        recordResult('诱饵元素检测', 'blocked', {
          blockedCount: blockedCount,
          totalBaits: baits.length,
          details: baitDetails
        }, 'local');
      } else {
        recordResult('诱饵元素检测', 'success', {
          blockedCount: 0,
          totalBaits: baits.length
        }, 'local');
      }
    }, 100);
  }
  
  function detectByAdSense() {
    setTimeout(function() {
      const adsenseExists = typeof window.adsbygoogle !== 'undefined';
      
      if (!adsenseExists) {
        recordResult('AdSense脚本检测', 'blocked', {
          reason: 'adsbygoogle对象未定义'
        }, 'intl_external');
      } else {
        recordResult('AdSense脚本检测', 'success', {
          adsenseLoaded: true
        }, 'intl_external');
      }
    }, 2000);
  }
  
  function detectByFetch() {
    const startTime = Date.now();
    
    const testUrl = '/static/ad-pixel.png?' + Date.now();
    
    fetch(testUrl, {
      method: 'GET'
    })
    .then(response => {
      if (response.ok) {
        const duration = Date.now() - startTime;
        recordResult('Fetch请求检测', 'success', {
          duration: duration
        }, 'local');
      } else {
        throw new Error('Request failed');
      }
    })
    .catch(function(error) {
      const duration = Date.now() - startTime;
      
      recordResult('Fetch请求检测', 'blocked', {
        error: error.message,
        errorType: error.name,
        duration: duration
      }, 'local');
    });
  }
  
  function detectByExternalDomain() {
    const cacheBuster = Date.now() + '_' + Math.random().toString(36).substring(2, 9);
    
    const adDomains = [
      {
        name: 'Google AdSense',
        url: 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js',
        fallback: 'https://googleads.g.doubleclick.net/pagead/ads'
      },
      {
        name: 'Google DoubleClick',
        url: 'https://securepubads.g.doubleclick.net/tag/js/gpt.js',
        fallback: null
      }
    ];
    
    let completedTests = 0;
    let failedDomains = [];
    let networkErrors = [];
    
    adDomains.forEach(function(domain, index) {
      const testUrl = domain.url + '?_cb=' + cacheBuster + '&_t=' + Date.now();
      
      const startTime = Date.now();
      const timeout = 5000;
      
      const timeoutId = setTimeout(function() {
        const duration = Date.now() - startTime;
        
        failedDomains.push(domain.name);
        networkErrors.push({
          domain: domain.name,
          error: 'timeout',
          duration: duration,
          reason: 'DNS解析超时或网络连接失败'
        });
        
        completedTests++;
        checkComplete();
      }, timeout);
      
      const script = document.createElement('script');
      script.src = testUrl;
      script.async = true;
      
      script.onload = function() {
        clearTimeout(timeoutId);
        completedTests++;
        checkComplete();
      };
      
      script.onerror = function(event) {
        clearTimeout(timeoutId);
        const duration = Date.now() - startTime;
        
        let errorReason = '未知错误';
        if (duration < 100) {
          errorReason = 'DNS解析失败或Hosts文件屏蔽';
        } else if (duration < 1000) {
          errorReason = '网关层连接被拒绝';
        } else {
          errorReason = '网络超时或服务器不可达';
        }
        
        failedDomains.push(domain.name);
        networkErrors.push({
          domain: domain.name,
          url: domain.url,
          error: 'network_error',
          duration: duration,
          reason: errorReason
        });
        
        completedTests++;
        checkComplete();
      };
      
      document.head.appendChild(script);
    });
    
    function checkComplete() {
      if (completedTests === adDomains.length) {
        if (failedDomains.length > 0) {
          recordResult('外部域名检测', 'blocked', {
            blockedDomains: failedDomains,
            totalTested: adDomains.length,
            errors: networkErrors,
            detectionType: 'DNS/Gateway/Hosts'
          }, 'intl_external');
        } else {
          recordResult('外部域名检测', 'success', {
            totalTested: adDomains.length,
            allAccessible: true
          }, 'intl_external');
        }
      }
    }
  }
  
  function detectByBaiduAd() {
    const startTime = Date.now();
    const script = document.createElement('script');
    script.src = 'https://cpro.baidustatic.com/cpro/ui/c.js?' + Date.now();
    script.async = true;
    
    let finished = false;
    function finish(status, extra) {
      if (finished) return;
      finished = true;
      clearTimeout(timeout);
      recordResult('国内广告联盟检测', status, Object.assign({ duration: Date.now() - startTime }, extra), 'cn_external');
    }
    
    const timeout = setTimeout(function() {
      finish('blocked', { error: 'timeout' });
    }, 5000);
    
    script.onload = function() {
      finish('success', {});
    };
    script.onerror = function() {
      finish('blocked', { error: 'network_error' });
    };
    document.head.appendChild(script);
  }
  
  function detectByCSSRule() {
    const testEl = document.createElement('div');
    testEl.className = 'ad-banner ad_banner textAd banner-ads';
    testEl.style.cssText = 'position:absolute;top:-10px;left:-10px;width:1px;height:1px;overflow:hidden;';
    testEl.innerHTML = '&nbsp;';
    document.body.appendChild(testEl);
    
    setTimeout(function() {
      const styles = window.getComputedStyle(testEl);
      const isHidden = styles.display === 'none' || 
                       styles.visibility === 'hidden' || 
                       styles.opacity === '0' ||
                       testEl.offsetHeight === 0;
      
      recordResult('CSS规则检测', isHidden ? 'blocked' : 'success', {
        display: styles.display,
        visibility: styles.visibility,
        opacity: styles.opacity
      }, 'local');
      
      if (testEl.parentNode) testEl.parentNode.removeChild(testEl);
    }, 200);
  }
  
  function detectByImage() {
    const testImg = new Image();
    const imgSrc = '/static/ad-pixel.png?' + Date.now();
    testImg.src = imgSrc;
    testImg.style.display = 'none';
    
    const startTime = Date.now();
    
    testImg.onerror = function() {
      const duration = Date.now() - startTime;
      
      recordResult('图片资源检测', 'blocked', {
        resource: 'ad-pixel.png',
        duration: duration
      }, 'local');
    };
    
    testImg.onload = function() {
      const duration = Date.now() - startTime;
      recordResult('图片资源检测', 'success', {
        resource: 'ad-pixel.png',
        size: testImg.width + 'x' + testImg.height,
        duration: duration
      }, 'local');
    };
    
    document.body.appendChild(testImg);
    
    setTimeout(function() {
      if (testImg.parentNode) {
        document.body.removeChild(testImg);
      }
    }, 2000);
  }
  
  function runDetection() {
    detectByBaitElement();
    detectByAdSense();
    detectByFetch();
    detectByImage();
    detectByExternalDomain();
    detectByBaiduAd();
    detectByCSSRule();
  }
  
  function showDetectionSummary() {
    const totalDuration = Date.now() - detectionResults.startTime;
    
    // 分类判定
    const localResults = detectionResults.results.filter(r => r.category === 'local');
    const cnExtResults = detectionResults.results.filter(r => r.category === 'cn_external');
    
    const localBlocked = localResults.some(r => r.status === 'blocked');
    const cnExtBlocked = cnExtResults.some(r => r.status === 'blocked');
    
    // 核心判定：本地检测或国内广告联盟检测被拦截 = 存在广告屏蔽
    // 仅国际外部（Google）失败 = 网络环境问题（GFW），不判定
    detectionResults.hasAdBlock = localBlocked || cnExtBlocked;
    
    const successCount = detectionResults.results.filter(r => r.status === 'success').length;
    const blockedCount = detectionResults.results.filter(r => r.status === 'blocked').length;
    
    const summary = {
      检测时间: new Date().toLocaleString(),
      总耗时: totalDuration + 'ms',
      检测方法数: detectionResults.totalTests,
      完成检测数: detectionResults.completedTests,
      成功通过: successCount,
      检测到屏蔽: blockedCount,
      最终结论: detectionResults.hasAdBlock ? '检测到广告屏蔽' : '未检测到广告屏蔽',
      屏蔽方法: detectionResults.blockedMethods,
      详细结果: detectionResults.results
    };
    
    displaySummaryOnPage(summary);
  }
  
  function displaySummaryOnPage(summary) {
    const existingModal = document.getElementById('adblock-modal-overlay');
    
    if (detectionResults.isRecheck && existingModal) {
      const closeBtn = document.getElementById('adblock-modal-close-btn');
      const spinner = document.getElementById('adblock-spinner');
      
      if (!detectionResults.hasAdBlock) {
        const modalContent = document.getElementById('adblock-modal-content');
        modalContent.style.animation = 'scaleOut 0.2s ease-out forwards';
        existingModal.style.animation = 'fadeOut 0.2s ease-out forwards';
        
        setTimeout(function() {
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';
          if (existingModal.parentElement) {
            existingModal.remove();
          }
          const modalStyles = document.getElementById('adblock-modal-styles');
          if (modalStyles) {
            modalStyles.remove();
          }
        }, 200);
      } else {
        if (spinner) {
          spinner.style.display = 'none';
        }
        const btnText = document.getElementById('adblock-btn-text');
        if (btnText) {
          btnText.textContent = '我已关闭';
        }
        if (closeBtn) {
          closeBtn.disabled = false;
        }
      }
      detectionResults.isRecheck = false;
      return;
    }
    
    if (!detectionResults.hasAdBlock) {
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      return;
    }
    
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    
    const modalOverlay = document.createElement('div');
    modalOverlay.id = 'adblock-modal-overlay';
    modalOverlay.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 999999;
      display: flex;
      justify-content: center;
      align-items: center;
      animation: fadeIn 0.3s ease-out; will-change: opacity;
    `;
    
    const modalContent = document.createElement('div');
    modalContent.id = 'adblock-modal-content';
    modalContent.className = 'adblock-modal-box';
    
    modalContent.innerHTML = `
      <div class="adblock-icon">📚</div>
      <div class="adblock-title">感谢您访问本站</div>
      <div class="adblock-desc">
        本站致力于提供优质的电子书查询服务<br>
        为了持续更新内容、维持服务器运行和带宽开销<br>
        我们需要广告来支撑网站的日常运营
      </div>
      <div class="adblock-desc" style="margin-bottom: 28px;">
        若您已安装广告拦截插件,恳请将本站加入白名单<br>
      </div>
      <div class="adblock-actions">
        <button id="adblock-modal-close-btn" class="adblock-btn-primary">
          <span id="adblock-btn-text">我已关闭</span>
          <span id="adblock-spinner" class="adblock-spinner"></span>
        </button>
        <button id="adblock-info-btn" class="adblock-btn-info">
          <span class="adblock-info-icon">!</span>
          <span>为什么总是检测失败?</span>
        </button>
      </div>
    `;
    
    modalOverlay.appendChild(modalContent);
    
    const style = document.createElement('style');
    style.id = 'adblock-modal-styles';
    style.textContent = `
      /* 日夜间模式CSS变量 */
      :root {
        --adblock-modal-bg: rgba(51, 51, 51, 0.95);
        --adblock-modal-border: rgba(255, 255, 255, 0.15);
        --adblock-modal-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
        --adblock-text-primary: #ffffff;
        --adblock-text-secondary: #dddddd;
        --adblock-text-muted: rgba(255, 255, 255, 0.7);
        --adblock-btn-bg: rgba(255, 255, 255, 0.15);
        --adblock-btn-border: rgba(255, 255, 255, 0.25);
        --adblock-btn-hover-bg: rgba(255, 255, 255, 0.25);
        --adblock-btn-hover-border: rgba(255, 255, 255, 0.4);
        --adblock-spinner-border: rgba(255, 255, 255, 0.3);
        --adblock-spinner-active: #ffffff;
      }
      [data-theme="light"] {
        --adblock-modal-bg: rgba(249, 243, 240, 0.98);
        --adblock-modal-border: rgba(0, 0, 0, 0.1);
        --adblock-modal-shadow: 0 12px 36px rgba(0, 0, 0, 0.15);
        --adblock-text-primary: #000000;
        --adblock-text-secondary: #333333;
        --adblock-text-muted: rgba(0, 0, 0, 0.6);
        --adblock-btn-bg: rgba(0, 0, 0, 0.08);
        --adblock-btn-border: rgba(0, 0, 0, 0.15);
        --adblock-btn-hover-bg: rgba(0, 0, 0, 0.12);
        --adblock-btn-hover-border: rgba(0, 0, 0, 0.25);
        --adblock-spinner-border: rgba(0, 0, 0, 0.2);
        --adblock-spinner-active: #000000;
      }
      
      /* 弹窗容器样式 */
      .adblock-modal-box {
        background: var(--adblock-modal-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid var(--adblock-modal-border);
        border-radius: 12px;
        padding: 35px 35px 10px 35px;
        box-shadow: var(--adblock-modal-shadow);
        max-width: 450px;
        width: 90%;
        text-align: center;
        animation: scaleIn 0.3s ease-out;
        will-change: transform, opacity;
      }
      .adblock-info-box {
        padding: 30px 35px;
        max-width: 420px;
      }
      
      /* 图标 */
      .adblock-icon {
        font-size: 48px;
        margin-bottom: 20px;
      }
      
      /* 标题 */
      .adblock-title {
        font-size: 20px;
        font-weight: 600;
        color: var(--adblock-text-primary);
        margin-bottom: 15px;
        line-height: 1.6;
        text-align: left;
        font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }
      
      /* 描述文字 */
      .adblock-desc {
        color: var(--adblock-text-secondary);
        margin-bottom: 15px;
        line-height: 1.7;
        text-align: left;
      }
      
      /* 操作按钮容器 */
      .adblock-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }
      
      /* 主按钮 */
      .adblock-btn-primary {
        background: var(--adblock-btn-bg);
        color: var(--adblock-text-primary);
        border: 1px solid var(--adblock-btn-border);
        padding: 12px 45px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 25px;
        cursor: pointer;
        transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      .adblock-btn-full {
        width: 100%;
        padding: 10px 30px;
        font-size: 14px;
        border-radius: 20px;
      }
      
      /* Spinner */
      .adblock-spinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid var(--adblock-spinner-border);
        border-top-color: var(--adblock-spinner-active);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        will-change: transform;
      }
      
      /* 信息按钮 */
      .adblock-btn-info {
        background: transparent;
        color: var(--adblock-text-muted);
        border: none;
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: color 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      
      /* 信息图标 */
      .adblock-info-icon {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--adblock-btn-bg);
        border: 1px solid var(--adblock-btn-border);
        color: var(--adblock-text-primary);
        font-size: 11px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.2s ease;
      }
      
      /* 信息弹窗标题 */
      .adblock-info-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--adblock-text-primary);
        margin-bottom: 18px;
        font-family: 'LXGW WenKai', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      }
      
      /* 信息弹窗描述 */
      .adblock-info-desc {
        color: var(--adblock-text-secondary);
        line-height: 1.7;
        font-size: 14px;
        margin-bottom: 20px;
        text-align: left;
      }
      
      /* 强调文本样式 */
      .adblock-highlight-text {
        font-weight: 700;
        font-size: 15px;
        background: linear-gradient(135deg, #ff6b6b, #ee5a6f);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 0 20px rgba(255, 107, 107, 0.3);
        position: relative;
        display: inline-block;
        padding: 0 3px;
      }
      [data-theme="light"] .adblock-highlight-text {
        background: linear-gradient(135deg, #d63031, #e84393);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 0 15px rgba(214, 48, 49, 0.2);
      }
      
      /* 动画 */
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes scaleIn {
        from {
          opacity: 0;
          transform: scale(0.9) translateY(-20px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }
      @keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      @keyframes scaleOut {
        from {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
        to {
          opacity: 0;
          transform: scale(0.9) translateY(-20px);
        }
      }
      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      
      /* 交互状态 */
      .adblock-btn-primary:hover:not(:disabled) {
        background: var(--adblock-btn-hover-bg);
        border-color: var(--adblock-btn-hover-border);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
      }
      .adblock-btn-primary:active:not(:disabled) {
        transform: translateY(0);
        background: var(--adblock-btn-bg);
      }
      .adblock-btn-primary:disabled {
        cursor: not-allowed;
        opacity: 0.7;
      }
      .adblock-btn-info:hover {
        color: var(--adblock-text-primary);
      }
      .adblock-btn-info:hover .adblock-info-icon {
        background: var(--adblock-btn-hover-bg);
        border-color: var(--adblock-btn-hover-border);
        transform: scale(1.1);
      }
      .adblock-btn-info:active .adblock-info-icon {
        transform: scale(0.95);
      }
    `;
    document.head.appendChild(style);
    document.body.appendChild(modalOverlay);
    
    const closeBtn = document.getElementById('adblock-modal-close-btn');
    closeBtn.addEventListener('click', function() {
      const btnText = document.getElementById('adblock-btn-text');
      const spinner = document.getElementById('adblock-spinner');
      
      closeBtn.disabled = true;
      btnText.textContent = '检测中...';
      spinner.style.display = 'inline-block';
      
      resetDetectionResults();
      
      runDetection();
    });
    
    // 添加感叹号按钮点击事件
    const infoBtn = document.getElementById('adblock-info-btn');
    if (infoBtn) {
      infoBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        showInfoModal();
      });
    }
  }
  
  // 显示检测原理说明弹窗
  function showInfoModal() {
    const existingInfo = document.getElementById('adblock-info-modal');
    if (existingInfo) {
      return;
    }
    
    const infoOverlay = document.createElement('div');
    infoOverlay.id = 'adblock-info-modal';
    infoOverlay.style.cssText = `
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 9999999;
      display: flex;
      justify-content: center;
      align-items: center;
      animation: fadeIn 0.3s ease-out; will-change: opacity;
    `;
    
    const infoContent = document.createElement('div');
    infoContent.className = 'adblock-modal-box adblock-info-box';
    
    infoContent.innerHTML = `
      <div class="adblock-info-title">💡 检测说明</div>
      <div class="adblock-info-desc">
        我们通过多种方式检测广告是否正常加载。当前检测到<span class="adblock-highlight-text">广告被拦截</span>。<br><br>简单来说就是广告被"屏蔽了"，常见原因包括系统或浏览器自带拦截、广告拦截或隐私插件等。
      </div>
      <button id="adblock-info-close" class="adblock-btn-primary adblock-btn-full">知道了</button>
    `;
    
    infoOverlay.appendChild(infoContent);
    document.body.appendChild(infoOverlay);
    
    // 关闭事件
    const closeInfoModal = function() {
      infoContent.style.animation = 'scaleOut 0.2s ease-out forwards';
      infoOverlay.style.animation = 'fadeOut 0.2s ease-out forwards';
      setTimeout(function() {
        if (infoOverlay.parentElement) {
          infoOverlay.remove();
        }
      }, 200);
    };
    
    document.getElementById('adblock-info-close').addEventListener('click', closeInfoModal);
    infoOverlay.addEventListener('click', function(e) {
      if (e.target === infoOverlay) {
        closeInfoModal();
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      runDetection();
    });
  } else {
    setTimeout(runDetection, 500);
  }
})();
</script>


